# /etc/mealie-mcp/mealie-mcp.env  (mode 600, read by systemd)
# Same settings as the repo's .env.template. Where that file says "Docker network
# address", use the other LXC's LAN IP here.

# --- Mealie -------------------------------------------------------------------
# Mealie's LAN address (Proxmox LXC IP and port), not the public URL
MEALIE_BASE_URL=http://192.168.1.50:9000
# Mealie > Profile > API Tokens > Create (name it mcp-server)
MEALIE_API_KEY=
# Where you open Mealie in a browser; used for recipe links. No trailing slash.
MEALIE_PUBLIC_URL=https://mealie.jamesorjamie.com

# --- Server -------------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8000
LOG_LEVEL=INFO
# LOG_FILE=/var/log/mealie-mcp/mealie_mcp_server.log

# --- OAuth via Authentik --------------------------------------------------------
# Leave commented for the first LAN test. Uncomment once the Authentik provider
# exists (see deploy/README.md, step 5). The server refuses to start if ISSUER is
# set without AUDIENCE.
# MCP_SERVER_URL=https://mealie-mcp.jamesorjamie.com
# AUTHENTIK_ISSUER=https://auth.jamesorjamie.com/application/o/mealie-mcp/
# AUTHENTIK_AUDIENCE=<provider client id>
# Fetch signing keys over the LAN instead of through Cloudflare:
# AUTHENTIK_JWKS_URI=http://192.168.1.51:9000/application/o/mealie-mcp/jwks/
# AUTHENTIK_HOST=auth.jamesorjamie.com
